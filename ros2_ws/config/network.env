# ============================================================================
#  CẤU HÌNH MẠNG — file DUY NHẤT cần sửa trên Jetson khi đổi WiFi
#  Vị trí: ~/mobile_robot/ros2_ws/config/network.env
#
#  - Ghi dạng KEY=VALUE, KHÔNG có khoảng trắng quanh dấu "=".
#  - esp32_alert_bridge đọc lại file này MỖI LẦN có sự cố mới:
#    sửa xong là có hiệu lực, không cần restart, không cần build lại.
#  - Xem IP hiện tại của Jetson và kiểm tra ESP32:  scripts/show_network.sh
#  - Đổi nhanh bằng lệnh:                           scripts/set_esp32_ip.sh 192.168.1.50
# ============================================================================

# IP của ESP32 MÀN HÌNH CẢNH BÁO (ESP32 có màn hình LCD, firmware main.cpp).
# Cách xem IP: khi ESP32 kết nối WiFi, màn hình hiển thị "IP:x.x.x.x UDP:4210 TCP:4211"
# (hoặc xem trên Serial Monitor). Jetson gửi cảnh báo té ngã tới địa chỉ này.
ESP32_ALERT_IP=amr-display.local

# Cổng nhận cảnh báo trên ESP32 màn hình. Đã cố định trong firmware
# (UDP_PORT, IMAGE_TCP_PORT) — chỉ đổi nếu bạn sửa firmware.
ESP32_ALERT_UDP_PORT=4210
ESP32_ALERT_TCP_PORT=4211

# LƯU Ý: 2 ESP32 NÚT BẤM (code_esp32_node.ino) thì ngược lại: chúng kết nối TỚI Jetson
# (cổng 5000), nên IP của Jetson nằm trong firmware của chúng (jetson_ip),
# KHÔNG nằm trong file này. Chạy scripts/show_network.sh để biết IP Jetson hiện tại.
